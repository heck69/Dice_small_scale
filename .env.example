# =============================================================================
# Dice Job Automation Bot — Environment Variables Configuration
# =============================================================================

# --- Telegram Bot Configuration ---
BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=optional_single_allowed_chat_id

# --- Dice.com Authentication ---
DICE_PASSWORD=your_dice_password_here

# --- Supabase Database ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- SendGrid (OTP Verification Emails) ---
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDER_EMAIL=noreply@applywizz.com

# --- Browserbase (Optional Cloud Browser) ---
USE_BROWSERBASE=false
BROWSERBASE_API_KEY=your_browserbase_api_key
BROWSERBASE_PROJECT_ID=your_browserbase_project_id
BROWSERBASE_MAX_CONCURRENT=20

# --- BlueBubbles / iMessage Integration ---
# URL of BlueBubbles server: http://localhost:1234 (if on same Mac) or https://mac-tunnel.domain.com (if on Railway)
BB_SERVER_URL=http://localhost:1234
# BlueBubbles server password configured in BlueBubbles App Settings > General
BB_PASSWORD=your_bluebubbles_password_here
# Port for the incoming iMessage webhook Express server
WEBHOOK_PORT=3001
# Shared secret token for webhook authentication (?secret=YOUR_TOKEN)
WEBHOOK_SECRET=your_random_webhook_secret_here
# Default country code for bare 10-digit numbers (e.g. 91 for India, 1 for US)
DEFAULT_COUNTRY_CODE=1
